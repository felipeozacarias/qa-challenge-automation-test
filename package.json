{
  "name": "qa-automation-cypress-cucumber",
  "version": "1.1.0",
  "description": "Projeto de automação de testes Web e API com Cypress, JavaScript e Cucumber/Gherkin",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:web": "cypress run --spec \"cypress/e2e/web/**/*.feature\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.feature\"",
    "ci": "cypress run --config video=false"
  },
  "keywords": [
    "qa",
    "cypress",
    "cucumber",
    "bdd",
    "javascript",
    "automation",
    "api-testing",
    "e2e"
  ],
  "author": "Felipe Zacarias",
  "license": "MIT",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^20.0.5",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
    "cypress": "^13.17.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.js"
    ],
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-report.json"
    },
    "messages": {
      "enabled": true,
      "output": "cypress/reports/messages.ndjson"
    }
  }
}

{
  "name": "qa-automation-cypress-cucumber",
  "version": "1.3.0",
  "description": "Projeto de automação de testes Web e API com Cypress, JavaScript e Cucumber/Gherkin",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:web": "cypress run --spec \"cypress/e2e/web/**/*.feature\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.feature\"",
    "test:smoke": "cypress run --config video=false --env tags=@smoke",
    "test:regression": "cypress run --config video=false --env tags=@regression",
    "test:critical": "cypress run --config video=false --env tags=@critical",
    "test:critical:chrome": "cypress run --browser chrome --config video=false --env tags=@critical",
    "test:critical:edge": "cypress run --browser edge --config video=false --env tags=@critical",
    "test:critical:firefox": "cypress run --browser firefox --config video=false --env tags=@critical",
    "browsers:info": "cypress info",
    "quality:gate": "node scripts/quality-gate.js 5",
    "report:html": "node scripts/generate-html-report.js",
    "ci": "cypress run --config video=false && npm run quality:gate && npm run report:html"
  },
  "keywords": [
    "qa",
    "cypress",
    "cucumber",
    "bdd",
    "javascript",
    "automation",
    "api-testing",
    "e2e",
    "quality-gate",
    "smoke-testing",
    "regression-testing",
    "cross-browser-testing"
  ],
  "author": "Felipe Zacarias",
  "license": "MIT",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^20.0.5",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.0",
    "cypress": "^13.17.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.js"
    ],
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-report.json"
    },
    "messages": {
      "enabled": true,
      "output": "cypress/reports/messages.ndjson"
    }
  }
}
